{
  "name": "formloom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next dev",
    "build": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next build",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "cf:build": "FORMLOOM_RUNTIME=cloudflare APP_URL=${APP_URL:-https://formloom.app} opennextjs-cloudflare build && node scripts/static-og.mjs",
    "cf:migrate": "wrangler d1 migrations apply formloom --remote",
    "cf:deploy": "pnpm cf:build && pnpm cf:migrate && opennextjs-cloudflare deploy",
    "cf:preview": "pnpm cf:build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@opennextjs/cloudflare": "1.20.18",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.75.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "4.166.0"
  },
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "description": "Open-source, self-hostable alternative to Typeform."
}
