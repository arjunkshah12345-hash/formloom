# Public URL of this instance (used for share links, embeds and secure cookies)
APP_URL=http://localhost:3000
# Where the SQLite database and uploaded images live
DATABASE_PATH=./data/formloom.db
UPLOAD_DIR=./data/uploads
# Set to "false" to stop new sign-ups after you've created your account
ALLOW_SIGNUPS=true
# Force secure cookies on/off (defaults to on when APP_URL is https)
# SECURE_COOKIES=true
# Link used for "Source" on the landing page (set this if you run a fork)
# REPO_URL=https://github.com/you/formloom
